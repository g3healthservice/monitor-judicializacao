# Monitor de licitacoes: variaveis opcionais (copie para .env ou use GitHub Secrets).
# Alertas por e-mail: as mesmas variaveis do monitor de judicializacao.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<sua conta>,
# SMTP_PASSWORD=<senha de app de 16 letras, nao a senha da conta>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Telegram (opcional): token do @BotFather e o chat_id da conversa com o bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Banco e arquivos (padroes entre parenteses)
# LIC_DB_PATH=monitor.db
# LIC_UASGS=250005
# LIC_COTACOES_PATH=monitor-licitacoes/cotacoes.csv
